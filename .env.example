# Server only. Use a SELECT-only account for Railway; migration uses an owner account locally.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/incident_log?sslmode=require&channel_binding=require

# Railway supplies PORT automatically. This default is convenient for local development.
PORT=3000
CORS_ORIGINS=https://skynetcountdown.org,https://www.skynetcountdown.org

# Public frontend configuration. For local API development, set http://127.0.0.1:3000/dataset.
VITE_API_URL=https://api.skynetcountdown.org/dataset
