{
  "name": "the-skynet-countdown",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/check-static-build.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts server/*.test.ts",
    "validate:data": "node --experimental-strip-types scripts/validate-data.ts",
    "test:e2e": "playwright test",
    "test:postgres": "node --experimental-strip-types --test server/storage.test.ts server/migration.integration.test.ts",
    "start:api": "node --experimental-strip-types --env-file-if-exists=.env server/index.ts",
    "dev:api": "node --watch --experimental-strip-types --env-file-if-exists=.env server/index.ts",
    "db:migrate": "node --experimental-strip-types --env-file-if-exists=.env scripts/migrate-postgres.ts",
    "db:check": "node --experimental-strip-types --env-file-if-exists=.env scripts/check-postgres.ts",
    "db:create-api-role": "node --experimental-strip-types --env-file-if-exists=.env scripts/create-api-role.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
